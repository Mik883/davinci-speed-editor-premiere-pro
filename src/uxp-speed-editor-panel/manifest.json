{
  "manifestVersion": 5,
  "id": "com.codex.speededitor.premiere.settings",
  "name": "Speed Editor Controls",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "speedEditorPanel",
      "label": {
        "default": "Speed Editor"
      },
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 760,
        "height": 720
      }
    }
  ]
}
